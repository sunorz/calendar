<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="22dp"
    android:paddingBottom="10dp">

    <!-- Chinese Layout Container -->
    <LinearLayout
        android:id="@+id/widget_layout_cn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Header: 星期(鲜红) 与 月份(次要灰) 居中紧挨 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/widget_text_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_today_weekday"
                android:textColor="@color/widget_text_red"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_text_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/widget_preview_today_month"
                android:textColor="@color/widget_text_secondary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Center Row: 大号日期数字 + 竖排农历/节气，整体居中 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="-8dp"
            android:orientation="horizontal"
            android:gravity="center">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/widget_text_day_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_today_day"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="80sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/widget_text_day_number_red"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_today_day"
                    android:textColor="@color/widget_text_red"
                    android:textSize="80sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:textStyle="bold"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_text_lunar_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/widget_preview_today_lunar"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:gravity="center_horizontal"
                android:layout_marginEnd="0dp" />
        </LinearLayout>
    </LinearLayout>

        <!-- English Layout Container -->
    <LinearLayout
        android:id="@+id/widget_layout_en"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top Header: "Fri Oct" 居中紧挨 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/widget_en_text_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_today_weekday"
                android:textColor="@color/widget_text_red"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_en_text_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/widget_preview_today_month"
                android:textColor="@color/widget_text_secondary"
                android:textSize="26sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Center Row: 超大日期数字，水平居中 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="-4dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/widget_en_text_day_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/widget_preview_today_day"
                android:textColor="@color/widget_text_primary"
                android:textSize="96sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_en_text_day_number_red"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/widget_preview_today_day"
                android:textColor="@color/widget_text_red"
                android:textSize="96sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:textStyle="bold"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>