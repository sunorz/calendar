            <TextView android:id="@+id/widget_day_17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 3 -->
        <LinearLayout
            android:id="@+id/widget_week_row_3"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_24" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 4 -->
        <LinearLayout
            android:id="@+id/widget_week_row_4"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_31" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_32" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_33" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_34" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 5 (Optional 6th week) -->
        <LinearLayout
            android:id="@+id/widget_week_row_5"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_38" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
