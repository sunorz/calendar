        <!-- Week Row 5 (Optional 6th week) -->
        <LinearLayout
            android:id="@+id/widget_week_row_5"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="1.5dp"
            android:layout_marginBottom="1.5dp"
