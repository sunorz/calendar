            <TextView android:id="@+id/widget_day_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_month_day" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_month_day" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 1 -->
        <LinearLayout
            android:id="@+id/widget_week_row_1"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="1.5dp"
