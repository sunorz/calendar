<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:gravity="center_horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Row 1: Year & Month Title (e.g. 2026年9月 / September 2026) -->
    <TextView
        android:id="@+id/widget_month_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2026年9月"
        android:textColor="@color/widget_text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginBottom="4dp" />

    <!-- Days Grid (Up to 6 weeks, dynamically weighted so bottom rows are never clipped) -->
    <LinearLayout
        android:id="@+id/widget_days_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Week Row 0 (Sept 2026 starts on Tuesday: cell 1..6 = 1..6) -->
        <LinearLayout
            android:id="@+id/widget_week_row_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="1" android:background="@drawable/bg_widget_today" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="2" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="3" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="4" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="5" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_red" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="6" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_red" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 1 (7..13) -->
        <LinearLayout
            android:id="@+id/widget_week_row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="7" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="8" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="9" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="10" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="11" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="12" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_red" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="13" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_red" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 2 (14..20, Sunday 20 is shift workday) -->
        <LinearLayout
            android:id="@+id/widget_week_row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="14" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="15" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="16" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="17" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="18" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="19" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_red" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="20" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 3 (21..27, Fri 25 - Sun 27 Mid-Autumn Festival) -->
        <LinearLayout
            android:id="@+id/widget_week_row_3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="21" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="22" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="23" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_24" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="24" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="25" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_red" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="26" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_red" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="27" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_red" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 4 (28..30) -->
        <LinearLayout
            android:id="@+id/widget_week_row_4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="28" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="29" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:text="30" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_31" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_32" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_33" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_34" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 5 (Optional 6th week, hidden in default 5-week preview) -->
        <LinearLayout
            android:id="@+id/widget_week_row_5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView android:id="@+id/widget_day_35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_38" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_39" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_41" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingBottom="3dp" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_primary" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
