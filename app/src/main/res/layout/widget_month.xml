            <TextView android:id="@+id/widget_day_32" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_month_day" android:includeFontPadding="false" />
