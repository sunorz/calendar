            <TextView android:id="@+id/widget_day_6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 1 -->
        <LinearLayout
            android:id="@+id/widget_week_row_1"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
        </LinearLayout>

        <!-- Week Row 2 -->
