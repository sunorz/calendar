        android:id="@+id/widget_days_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Week Row 0 -->
        <LinearLayout
            android:id="@+id/widget_week_row_0"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="1.5dp"
            android:layout_marginBottom="1.5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_month_day" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/widget_text_month_day" android:includeFontPadding="false" />
