<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:gravity="center"
    android:padding="8dp">

    <!-- Row 1: Year & Month Title (e.g. 2026年9月 / September 2026) -->
    <TextView
        android:id="@+id/widget_month_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2026年9月"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_marginBottom="4dp" />

    <!-- Row 2: Weekday Headers (一 二 三 四 五 六 日 / M T W T F S S) -->
    <LinearLayout
        android:id="@+id/widget_weekday_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/widget_weekday_0"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="一"
            android:textColor="@color/widget_text_week"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_weekday_1"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="二"
            android:textColor="@color/widget_text_week"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_weekday_2"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="三"
            android:textColor="@color/widget_text_week"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_weekday_3"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="四"
            android:textColor="@color/widget_text_week"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_weekday_4"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="五"
            android:textColor="@color/widget_text_week"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_weekday_5"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="六"
            android:textColor="@color/widget_text_red"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_weekday_6"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="日"
            android:textColor="@color/widget_text_red"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <!-- Row 3+: Days Grid (Up to 6 weeks, tightly and elegantly proportioned) -->
    <LinearLayout
        android:id="@+id/widget_days_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Week Row 0 -->
        <LinearLayout
            android:id="@+id/widget_week_row_0"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView android:id="@+id/widget_day_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
            <TextView android:id="@+id/widget_day_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="11.5sp" android:textStyle="bold" android:includeFontPadding="false" />
