<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:gravity="top|start"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="12dp">

    <!-- Chinese Layout Container -->
    <LinearLayout
        android:id="@+id/widget_layout_cn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top|start"
        android:visibility="visible">

        <!-- Top Header Row: 星期 (iOS鲜红加粗) + 月份 (次要灰) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_text_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_today_weekday"
                android:textColor="@color/widget_text_red"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_text_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_today_month"
                android:textColor="@color/widget_text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Center Row: 大方舒展的日期数字 + 竖排农历/节气 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical|start"
            android:layout_marginTop="1dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/widget_text_day_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_today_day"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="64sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false" />
                <TextView
                    android:id="@+id/widget_text_day_number_red"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_preview_today_day"
                    android:textColor="@color/widget_text_red"
                    android:textSize="64sp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:letterSpacing="-0.02"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/widget_text_lunar_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_today_lunar"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- English Layout Container -->
    <LinearLayout
        android:id="@+id/widget_layout_en"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top|start"
        android:visibility="gone">

        <!-- Top Header: 红色小字全大写 WEEKDAY，带 tracking 字符间距 -->
        <TextView
            android:id="@+id/widget_en_text_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_today_weekday"
            android:textColor="@color/widget_text_red"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_en_text_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_preview_today_month"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="1dp">
            <TextView
                android:id="@+id/widget_en_text_day_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_today_day"
                android:textColor="@color/widget_text_primary"
                android:textSize="64sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_en_text_day_number_red"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_preview_today_day"
                android:textColor="@color/widget_text_red"
                android:textSize="64sp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:letterSpacing="-0.02"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
